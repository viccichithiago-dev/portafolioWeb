---
const avatarUrl = '/android-chrome-192x192.png';
const githubName = 'Thiago Viccichi';
---

<section class="py-24 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="grid md:grid-cols-5 gap-12 items-center">
      <div class="md:col-span-3">
        <div class="flex items-center gap-2 text-sm font-medium text-[var(--text-muted)] mb-4 tracking-wide">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
          </svg>
          <span data-i18="hero.role">Backend Developer</span>
        </div>
        
        <h1 class="text-5xl md:text-6xl font-semibold text-[var(--text-primary)] mb-6 tracking-tight" style="letter-spacing: -0.02em;">
          <span class="inline-flex items-center gap-3">
            <span data-i18="hero.title">Hola, soy Thiago Viccichi</span>
            <svg class="w-10 h-10 text-[var(--accent)]" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          </span>
        </h1>
        
        <p class="text-lg text-[var(--text-secondary)] leading-relaxed mb-8 max-w-2xl" data-i18="hero.description">
          Estudiante de Ingeniería en Informática de Buenos Aires. Construyo soluciones robustas con el ecosistema de Java y Spring Boot, siempre priorizando el código limpio y arquitecturas escalables.
        </p>

        <div class="flex flex-wrap gap-4">
          <a
            href="https://github.com/viccichithiago-dev"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-[var(--accent-dark)] text-white rounded-[8px] text-sm font-semibold hover:bg-[var(--accent-hover)] transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            <span data-i18="hero.github">GitHub</span>
          </a>
          <a
            href="https://www.linkedin.com/in/thiago-viccichi-6a7381231/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-[var(--accent-dark)] text-white rounded-[8px] text-sm font-semibold hover:bg-[var(--accent-hover)] transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            <span data-i18="hero.linkedin">LinkedIn</span>
          </a>
          <a
            href="/Thiago_Viccichi_Backend_Developer.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-[var(--accent-dark)] text-white rounded-[8px] text-sm font-semibold hover:bg-[var(--accent-hover)] transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <span data-i18="hero.curriculum">Curriculum</span>
          </a>
        </div>
      </div>
      
      <div class="md:col-span-2 flex justify-center md:justify-end">
        <img 
          src={avatarUrl} 
          alt={githubName}
          class="w-64 h-64 rounded-full border-2 border-[var(--border-color)] object-cover shadow-lg"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<script>
  window.addEventListener('translations-ready', (e: Event) => {
    const { t } = (e as CustomEvent).detail;
    
    const roleEl = document.querySelector('[data-i18="hero.role"]');
    const titleEl = document.querySelector('[data-i18="hero.title"]');
    const descEl = document.querySelector('[data-i18="hero.description"]');
    const githubEl = document.querySelector('[data-i18="hero.github"]');
    const linkedinEl = document.querySelector('[data-i18="hero.linkedin"]');
    const curriculumEl = document.querySelector('[data-i18="hero.curriculum"]');
    
    if (roleEl) roleEl.textContent = t.hero.role;
    if (titleEl) titleEl.textContent = t.hero.title;
    if (descEl) descEl.textContent = t.hero.description;
    if (githubEl) githubEl.textContent = t.hero.github;
    if (linkedinEl) linkedinEl.textContent = t.hero.linkedin;
    if (curriculumEl) curriculumEl.textContent = t.hero.curriculum;
  });
</script>