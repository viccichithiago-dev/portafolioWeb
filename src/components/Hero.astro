---
const socialLinks = [
  { name: 'GitHub', url: 'https://github.com/viccichithiago-dev' },
  { name: 'LinkedIn', url: 'https://www.linkedin.com/in/thiago-viccichi-6a7381231/' },
];

const GITHUB_USERNAME = 'viccichithiago-dev';

let avatarUrl = '';
let githubName = '';

try {
  const response = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}`);
  if (response.ok) {
    const data = await response.json();
    avatarUrl = data.avatar_url;
    githubName = data.name || GITHUB_USERNAME;
  }
} catch (e) {
  // Silently fail - no avatar
}
---

<section class="py-24 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="grid md:grid-cols-5 gap-12 items-center">
      <div class="md:col-span-3">
        <div class="flex items-center gap-2 text-sm font-medium text-[#6b7280] mb-4 tracking-wide">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
          </svg>
          Backend Developer
        </div>
        
        <h1 class="text-5xl md:text-6xl font-semibold text-[#111111] mb-6 tracking-tight" style="letter-spacing: -0.02em;">
          <span class="inline-flex items-center gap-3">
            Hola, soy Thiago Viccichi
            <svg class="w-10 h-10 text-[#c084fc]" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          </span>
        </h1>
        
        <p class="text-lg text-[#374151] leading-relaxed mb-8 max-w-2xl">
          Escribo código pensando en la escalabilidad y en el equipo del futuro. Especialista en Backend con Java y Spring Boot, enfocado en Clean Code y arquitectura sólida.
        </p>

        <div class="flex flex-wrap gap-4">
          {socialLinks.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center px-5 py-2.5 bg-[#111111] text-[#ffffff] rounded-[8px] text-sm font-semibold hover:bg-[#242424] transition-colors"
            >
              {link.name}
            </a>
          ))}
          <a
            href="/Thiago_Viccichi_Backend_Developer.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-5 py-2.5 bg-[#111111] text-[#ffffff] rounded-[8px] text-sm font-semibold hover:bg-[#242424] transition-colors"
          >
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            Curriculum
          </a>
        </div>
      </div>
      
      <div class="md:col-span-2 flex justify-center md:justify-end">
        {avatarUrl ? (
          <img 
            src={avatarUrl} 
            alt={githubName}
            class="w-64 h-64 rounded-full border-2 border-[#e5e7eb] object-cover shadow-lg"
          />
        ) : null}
      </div>
    </div>
  </div>
</section>