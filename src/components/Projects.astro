---
import Section from './Section.astro';

interface Repository {
  id: number;
  name: string;
  description: string | null;
  html_url: string;
  language: string | null;
  stargazers_count: number;
  forks_count: number;
}

const GITHUB_USERNAME = 'viccichithiago-dev';

const fallbackRepos: Repository[] = [
  {
    id: 1,
    name: 'portfolio',
    description: 'Mi portafolio personal hecho con Astro y Tailwind CSS',
    html_url: 'https://github.com/viccichithiago-dev/portfolio',
    language: 'Astro',
    stargazers_count: 0,
    forks_count: 0
  },
  {
    id: 2,
    name: 'spring-boot-api',
    description: 'API RESTful construida con Spring Boot y PostgreSQL',
    html_url: 'https://github.com/viccichithiago-dev/spring-boot-api',
    language: 'Java',
    stargazers_count: 0,
    forks_count: 0
  },
  {
    id: 3,
    name: 'docker-projects',
    description: 'Configuraciones y ejemplos de Docker para aplicaciones backend',
    html_url: 'https://github.com/viccichithiago-dev/docker-projects',
    language: 'Docker',
    stargazers_count: 0,
    forks_count: 0
  }
];

let repos: Repository[] = [];
let useFallback = false;

try {
  const response = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=100`);
  
  if (response.ok) {
    const data = await response.json();
    if (Array.isArray(data) && data.length > 0) {
      const sortedRepos = data
        .filter((repo: Repository) => !repo.forks_count)
        .sort((a: Repository, b: Repository) => b.stargazers_count - a.stargazers_count)
        .slice(0, 3);
      repos = sortedRepos;
    } else {
      useFallback = true;
    }
  } else {
    useFallback = true;
  }
} catch (e) {
  useFallback = true;
}

if (useFallback) {
  repos = fallbackRepos;
}

const languageColors: Record<string, string> = {
  Java: '#b07219',
  Go: '#00ADD8',
  JavaScript: '#f1e05a',
  TypeScript: '#3178c6',
  Python: '#3572A5',
  'C#': '#178600',
  Shell: '#89e051',
  Docker: '#2496ED',
  Astro: '#FF5A03',
};
---

<Section id="projects">
  <h2 class="text-2xl font-semibold text-[#111111] pb-4 border-b-2 border-[#c084fc] mb-8" style="letter-spacing: -0.02em;">
    <span class="inline-flex items-center gap-2">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
      </svg>
      Proyectos
    </span>
  </h2>
  
  <div class="grid gap-6 md:grid-cols-3">
    {repos.map((repo) => (
      <a
        href={repo.html_url}
        target="_blank"
        rel="noopener noreferrer"
        class="group block p-8 bg-[#f5f5f5] rounded-[12px] hover:shadow-md transition-all duration-200"
      >
        <h3 class="text-lg font-semibold text-[#111111] group-hover:text-[#c084fc] transition-colors mb-3">
          {repo.name}
        </h3>
        
        <p class="text-sm text-[#6b7280] leading-relaxed mb-4 line-clamp-3">
          {repo.description || 'Sin descripción'}
        </p>
        
        <div class="flex items-center gap-4 text-xs text-[#6b7280]">
          {repo.language && (
            <span class="flex items-center gap-1.5">
              <span 
                class="w-3 h-3 rounded-full" 
                style={`background-color: ${languageColors[repo.language] || '#6b7280'}`}
              ></span>
              {repo.language}
            </span>
          )}
          
          <span class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            {repo.stargazers_count}
          </span>
        </div>
      </a>
    ))}
  </div>
  
  <div class="mt-8">
    <a
      href={`https://github.com/${GITHUB_USERNAME}`}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center text-sm font-medium text-[#c084fc] hover:text-[#9333ea] transition-colors"
    >
      Ver todos los proyectos →
    </a>
  </div>
</Section>