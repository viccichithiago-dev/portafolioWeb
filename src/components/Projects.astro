---
import Section from './Section.astro';

interface Repository {
  id: number;
  name: string;
  description: string | null;
  html_url: string;
  language: string | null;
  stargazers_count: number;
  forks_count: number;
  topics?: string[];
  isUpcoming?: boolean;
}

const fallbackRepos: Repository[] = [
  {
    id: 1,
    name: 'Sistema de Reservación de Películas',
    description: '🎬 Sistema integral de reservas de cine basado en microservicios. API REST con Spring Boot 3.5 que gestiona flujos complejos: cartelera dinámica, disponibilidad de asientos en tiempo real, autenticación RBAC (JWT) y estadísticas administrativas. Arquitectura limpia testeada con JUnit 5 y Mockito',
    html_url: 'https://github.com/viccichithiago-dev/Sistema-de-Reservaci-n-para-Cines.git',
    language: 'Java',
    stargazers_count: 0,
    forks_count: 0,
    topics: ['Spring Boot', 'Java 21', 'PostgreSQL', 'JWT', 'Swagger', 'Docker', 'Lombok', 'Mockito', 'JUnit']
  },
  {
    id: 2,
    name: 'Cloud Image Service',
    description: '🚀 API REST robusta desarrollada con Spring Boot 3.5 y Java 21 para la gestión y procesamiento dinámico de imágenes. Incluye autenticación JWT, almacenamiento en AWS S3 (LocalStack) y transformaciones programáticas (Resize, Filter, Watermark). Arquitectura escalable y documentada con Swagger',
    html_url: 'https://github.com/viccichithiago-dev/cloud-image-service.git',
    language: 'Java',
    stargazers_count: 0,
    forks_count: 0,
    topics: ['Spring Boot', 'Java 21', 'PostgreSQL', 'AWS S3', 'JWT', 'Swagger', 'Docker']
  },
  {
    id: 3,
    name: 'microservices-app',
    description: '📱 Próximamente: Aplicación completa de microservicios desarrollada con las mejores prácticas de arquitectura distribuida',
    html_url: 'https://github.com/viccichithiago-dev/microservices-app',
    language: 'Java',
    stargazers_count: 0,
    forks_count: 0,
    topics: ['Próximamente', 'Microservicios', 'Spring Boot', 'Docker'],
    isUpcoming: true
  }
];

const repos = fallbackRepos;

const languageColors: Record<string, string> = {
  Java: '#b07219',
  Go: '#00ADD8',
  JavaScript: '#f1e05a',
  TypeScript: '#3178c6',
  Python: '#3572A5',
  'C#': '#178600',
  Shell: '#89e051',
  Docker: '#2496ED',
  Astro: '#FF5A03',
};
---

<Section id="projects">
  <h2 class="text-2xl font-semibold text-[var(--text-primary)] pb-4 border-b-2 border-[var(--accent)] mb-8" style="letter-spacing: -0.02em;">
    <span class="inline-flex items-center gap-2">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
      </svg>
      <span data-i18="projects.title">Proyectos</span>
    </span>
  </h2>
  
  <div class="grid gap-6 md:grid-cols-3">
    {repos.map((repo, index) => (
      <a
        href={repo.html_url}
        target="_blank"
        rel="noopener noreferrer"
        class={`group block p-8 rounded-[12px] transition-all duration-200 project-card ${repo.isUpcoming ? 'bg-[var(--bg-secondary)] opacity-75 hover:opacity-100' : 'bg-[var(--bg-secondary)] hover:shadow-md'}`}
        data-project-index={index}
      >
        {repo.isUpcoming && (
          <div class="flex justify-end mb-2">
            <span class="px-3 py-1 text-xs bg-amber-100 text-amber-700 rounded-full font-medium" data-i18="projects.upcoming">
              Próximamente
            </span>
          </div>
        )}
        
        <h3 class="text-lg font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors mb-3 project-name">
          {repo.isUpcoming ? 'App de Microservicios' : repo.name}
        </h3>
        
        <p class="text-base text-[var(--text-muted)] leading-relaxed mb-4 line-clamp-4 project-desc">
          {repo.description}
        </p>
        
        <div class="flex flex-wrap gap-2 mb-4 project-tags">
          {repo.topics?.map((tag) => (
            <span class={`px-2 py-1 text-xs rounded-full font-medium ${tag === 'Próximamente' ? 'bg-amber-100 text-amber-700' : 'bg-[var(--accent)]/20 text-[var(--accent-dark)]'}`}>
              {tag}
            </span>
          ))}
        </div>
        
        {!repo.isUpcoming && (
          <div class="flex items-center gap-4 text-sm text-[var(--text-muted)]">
            {repo.language && (
              <span class="flex items-center gap-1.5">
                <span 
                  class="w-3 h-3 rounded-full" 
                  style={`background-color: ${languageColors[repo.language] || '#6b7280'}`}
                ></span>
                {repo.language}
              </span>
            )}
          </div>
        )}
      </a>
    ))}
  </div>
  
  <div class="mt-8 flex justify-center">
    <a
      href="https://github.com/viccichithiago-dev"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-6 py-3 bg-[var(--accent-dark)] text-white rounded-[8px] text-sm font-semibold hover:bg-[var(--accent-hover)] transition-colors shadow-sm"
    >
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
      </svg>
      <span data-i18="projects.seeAll">Ver todos en GitHub</span>
    </a>
  </div>
</Section>

<script>
  interface ProjectData {
    name: string;
    description: string;
    upcoming: string;
    tags: string[];
  }

  const projectsData: Record<string, ProjectData> = {
    es: {
      name: 'App de Microservicios',
      description: '📱 Próximamente: Aplicación completa de microservicios desarrollada con las mejores prácticas de arquitectura distribuida',
      upcoming: 'Próximamente',
      tags: ['Próximamente', 'Microservicios', 'Spring Boot', 'Docker']
    },
    en: {
      name: 'Microservices App',
      description: '📱 Coming soon: Complete microservices application developed with best distributed architecture practices',
      upcoming: 'Coming Soon',
      tags: ['Coming Soon', 'Microservices', 'Spring Boot', 'Docker']
    }
  };

  window.addEventListener('translations-ready', (e: Event) => {
    const { t, lang } = (e as CustomEvent).detail;
    const data = projectsData[lang];
    const cards = document.querySelectorAll('.project-card');
    const upcomingCard = cards[2];
    
    if (upcomingCard) {
      const nameEl = upcomingCard.querySelector('.project-name');
      const descEl = upcomingCard.querySelector('.project-desc');
      const tagContainer = upcomingCard.querySelector('.project-tags');
      const upcomingTag = upcomingCard.querySelector('[data-i18="projects.upcoming"]');
      
      if (nameEl) nameEl.textContent = data.name;
      if (descEl) descEl.textContent = data.description;
      if (upcomingTag) upcomingTag.textContent = data.upcoming;
      
      if (tagContainer) {
        tagContainer.innerHTML = data.tags.map(tag => 
          `<span class="px-2 py-1 text-xs rounded-full font-medium bg-amber-100 text-amber-700">${tag}</span>`
        ).join('');
      }
    }

    const seeAllBtn = document.querySelector('[data-i18="projects.seeAll"]');
    if (seeAllBtn) seeAllBtn.textContent = t.projects.seeAll;
  });
</script>