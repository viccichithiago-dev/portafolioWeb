---
import ThemeToggle from '../components/ThemeToggle.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import translations from '../i18n/translations.json';

interface Props {
  title: string;
}

const { title } = Astro.props;

const lang = 'es';
const t = translations[lang];

const description = lang === 'es' 
  ? "Thiago Viccichi - Backend Developer especializado en Java, Spring Boot y arquitecturas escalables. Estudiante de Ingeniería en Informática de Buenos Aires."
  : "Thiago Viccichi - Backend Developer specialized in Java, Spring Boot, and scalable architectures. Computer Engineering student from Buenos Aires.";
  
const canonicalURL = Astro.url.origin + Astro.url.pathname;
const ogImage = "/favicon-32x32.png";

import '../styles/global.css'
---

<!doctype html lang="es" style="scroll-behavior: smooth;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO -->
    <title>{title} | Thiago Viccichi - Backend Developer</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | Thiago Viccichi`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} | Thiago Viccichi`} />
    <meta name="twitter:description" content={description} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
      const savedLang = localStorage.getItem('lang') || 'es';
      document.documentElement.setAttribute('lang', savedLang);
    </script>
  </head>
  <body class="bg-[var(--bg-primary)] text-[var(--text-primary)] font-['Inter',_system-ui,_-apple-system,_BlinkMacSystemFont,'Segoe_UI',_Roboto,_sans-serif]">
    <nav class="fixed top-0 left-0 right-0 z-50 bg-[var(--bg-primary)] border-b border-[var(--border-color)]">
      <div class="max-w-5xl mx-auto px-6 h-16 flex justify-between items-center">
        <a href="/" class="text-lg font-semibold text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors">
          Thiago Viccichi
        </a>
        <div class="flex items-center gap-4">
          <div class="flex gap-6 text-sm font-medium">
            <a href="#about" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors" data-i18="nav.about">{t.nav.about}</a>
            <a href="#projects" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors" data-i18="nav.projects">{t.nav.projects}</a>
            <a href="#techstack" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors" data-i18="nav.techstack">{t.nav.techstack}</a>
            <a href="#contact" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors" data-i18="nav.contact">{t.nav.contact}</a>
          </div>
          <div class="flex items-center gap-2">
            <LanguageToggle />
            <ThemeToggle />
          </div>
        </div>
      </div>
    </nav>

    <main class="pt-16">
      <slot />
    </main>

    <footer class="bg-[var(--bg-footer)] text-[var(--text-footer)] py-16">
      <div class="max-w-5xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
          <div>
            <h3 class="text-white font-semibold mb-4">{t.footer.name}</h3>
            <p class="text-sm">{t.footer.role}</p>
          </div>
          <div>
            <h3 class="text-white font-semibold mb-4">{t.footer.links}</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="#about" class="hover:text-white transition-colors" data-i18="nav.about">{t.nav.about}</a></li>
              <li><a href="#projects" class="hover:text-white transition-colors" data-i18="nav.projects">{t.nav.projects}</a></li>
              <li><a href="#techstack" class="hover:text-white transition-colors" data-i18="nav.techstack">{t.nav.techstack}</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-white font-semibold mb-4">{t.footer.connect}</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="https://github.com/viccichithiago-dev" target="_blank" class="hover:text-white transition-colors">GitHub</a></li>
              <li><a href="https://www.linkedin.com/in/thiago-viccichi-6a7381231/" target="_blank" class="hover:text-white transition-colors">LinkedIn</a></li>
              <li><a href="https://mail.google.com/mail/?view=cm&to=cathiagoviccichi@gmail.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Email</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-[var(--border-footer)] pt-8 text-center text-sm">
          {t.footer.copyright}
        </div>
      </div>
    </footer>

    <script>
      import translations from '../i18n/translations.json';

      function updateTranslations(lang: string) {
        const t = translations[lang as keyof typeof translations] || translations.es;
        
        document.querySelectorAll('[data-i18]').forEach((el) => {
          const key = el.getAttribute('data-i18');
          if (key) {
            const keys = key.split('.');
            let value: any = t;
            for (const k of keys) {
              value = value?.[k];
            }
            if (value) {
              el.textContent = value;
            }
          }
        });
        
        document.querySelectorAll('[data-i18-placeholder]').forEach((el) => {
          const key = el.getAttribute('data-i18-placeholder');
          if (key) {
            const keys = key.split('.');
            let value: any = t;
            for (const k of keys) {
              value = value?.[k];
            }
            if (value) {
              (el as HTMLInputElement).placeholder = value;
            }
          }
        });
        
        window.dispatchEvent(new CustomEvent('translations-ready', { detail: { t, lang } }));
      }

      const currentLang = document.documentElement.getAttribute('lang') || 'es';
      updateTranslations(currentLang);

      window.addEventListener('i18n', (e: Event) => {
        const lang = (e as CustomEvent).detail;
        updateTranslations(lang);
      });
    </script>
  </body>
</html>